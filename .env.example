# Server-only PostgreSQL application schema. Keep idoc until the coordinated schema cutover.
# Vercel cutover values: production=idoc_production; staging branch preview=idoc_staging.
DB_SCHEMA=idoc
# Server-only launch hold. Only the exact value false permits member communications/live billing.
DISABLE_MEMBER_COMMUNICATIONS_AND_BILLING=true
# This is an example of your .env file format, which pnpm db:setup will create.
# Note: this must be .env, not .env.local, without further configuration changes.
POSTGRES_URL=postgresql://***
STRIPE_SECRET_KEY=sk_test_***
STRIPE_WEBHOOK_SECRET=whsec_***
STRIPE_MEMBERSHIP_PRODUCT_ID=prod_***
BASE_URL=http://localhost:3000
AUTH_SECRET=***
MFA_PENDING_AUTH_SIGNING_KEY=base64url-encoded-32-byte-key
MFA_TOTP_ACTIVE_KEY_ID=v1
MFA_TOTP_ENCRYPTION_KEYS={"v1":"base64url-encoded-exactly-32-byte-key"}
# Optional. Declares TOTP key IDs (must already be in MFA_TOTP_ENCRYPTION_KEYS, never the active
# one) as compromised (decryption refused) or retired (operator-confirmed fully decommissioned; a
# key still referenced by a real factor is flagged as an anomaly, not silently trusted). A key ID
# may be in at most one of these two lists.
MFA_TOTP_COMPROMISED_KEY_IDS=["old-key-id"]
MFA_TOTP_RETIRED_KEY_IDS=["older-key-id"]
MFA_RECOVERY_CODE_DIGEST_KEY=base64url-encoded-at-least-32-byte-key
LOGIN_DEVICE_TRUST_DIGEST_KEY=base64url-encoded-at-least-32-byte-key
MAILCHIMP_TRANSACTIONAL_API_KEY=***
RATE_LIMIT_HASH_KEY=***
TURNSTILE_SECRET_KEY=***
NEXT_PUBLIC_TURNSTILE_SITE_KEY=***
# Public error-ingestion configuration. A Sentry DSN is an ingest identifier, not a secret; use a
# separate project/DSN if local events must not enter the staging project.
NEXT_PUBLIC_SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
# Optional public override (for example, "staging"). Vercel environment metadata is used otherwise.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Build-time source-map upload credential for the existing pixelsmith-platform/idoc project.
# This is secret and server/build only. The Vercel Marketplace integration normally supplies it.
SENTRY_AUTH_TOKEN=***
# Optional server-only address autocomplete. Without it, onboarding remains fully usable with manual address entry.
GEOAPIFY_API_KEY=***
# Server-only Cloudinary credentials used by News/Blog thumbnails and Tiptap image insertion.
# Use the API key and API secret from the IDOC Cloudinary product environment.
CLOUDINARY_CLOUD_NAME=z6xv27qx
CLOUDINARY_API_KEY=***
CLOUDINARY_API_SECRET=***
# Canonical Google OIDC provider contract from pixelsmith-auth-reference 1.10.0.
GOOGLE_OAUTH_CLIENT_ID=***
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# The client secret is always configured as a rotation-ready ring: a JSON object mapping each
# version label to its Google-issued secret, plus the version label currently active. A deployment
# that never rotates still sets both, with a single entry. To rotate, add the new version to
# VERSIONS before flipping ACTIVE_VERSION to it (both an old and a newly generated secret can stay
# present during Google's own rotation overlap window). Rolling back is just pointing the active
# version back at a still-present prior one; retiring one is just removing it from the map. Run
# `pnpm google:rotate-secret` after redeploying with a new active version to record a secret-free
# audit trail entry of the change.
GOOGLE_OAUTH_CLIENT_SECRET_VERSIONS={"v1":"***"}
GOOGLE_OAUTH_CLIENT_SECRET_ACTIVE_VERSION=v1
