{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IDOC live authentication test results",
  "type": "object",
  "required": [
    "schemaVersion",
    "target",
    "startedAt",
    "completedAt",
    "results"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "target": {
      "type": "object",
      "required": [
        "hostname"
      ],
      "properties": {
        "hostname": {
          "type": "string"
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "startedAt": {
      "type": "string"
    },
    "completedAt": {
      "type": "string"
    },
    "tester": {
      "type": "string"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^LIVE-AUTH-[0-9]{3}$"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "blocked",
              "not-applicable"
            ]
          },
          "summary": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "retainedTestState": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
