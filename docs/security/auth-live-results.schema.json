{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IDOC live authentication test results",
  "type": "object",
  "required": [
    "schemaVersion",
    "target",
    "startedAt",
    "completedAt",
    "results"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "target": {
      "type": "object",
      "required": [
        "hostname"
      ],
      "properties": {
        "hostname": {
          "type": "string"
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "startedAt": {
      "type": "string"
    },
    "completedAt": {
      "type": "string"
    },
    "tester": {
      "type": "string"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^LIVE-AUTH-[0-9]{3}$"
          },
          "status": {
            "enum": [
              "pass",
              "partial",
              "fail",
              "blocked",
              "not-applicable"
            ]
          },
          "summary": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "retainedTestState": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "description": "Machine-readable coverage verdict, independent of the GitHub Actions workflow conclusion. 'verified' requires a full pass of every applicable catalog case; 'incomplete' does not mean the unexecuted cases succeeded.",
      "required": [
        "status",
        "fullyVerified",
        "applicable",
        "partiallyExercised",
        "failed",
        "notRun",
        "explanation"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "failed",
            "incomplete"
          ]
        },
        "fullyVerified": {
          "type": "integer",
          "minimum": 0
        },
        "applicable": {
          "type": "integer",
          "minimum": 0
        },
        "partiallyExercised": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "notRun": {
          "type": "integer",
          "minimum": 0
        },
        "explanation": {
          "type": "string"
        }
      }
    }
  }
}
